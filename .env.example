VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# T-301 Resonance Engine V2 rollout.
# 'on' = client uses server-side /match/candidate + /profiles/hydrate (REQUIRED
# in production — owner-only Firestore rules block the legacy client-side users
# scan, so 'off' yields zero candidates). Production (.env.production) MUST be 'on'.
VITE_MATCH_CANDIDATE_API=on
# Server-side kill switch (lambda env, seen-reflect-proxy): MATCH_ENGINE=legacy
# DISABLES /match/candidate (returns {candidate:null,"disabled"}). For matching to
# work this must be UNSET or any non-"legacy" value. Do NOT set it to 'legacy' in prod.
