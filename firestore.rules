rules_version = '2';

// Seen — Firestore security rules (T-301 / backlog T-003)
//
// Core invariant for the Resonance Engine V2:
//   - users/{uid} is readable ONLY by its owner.
//   - All cross-user reads (candidate selection, profile hydration) must go
//     through the backend Admin SDK, which bypasses these rules.
// This is what stops the client from fetching other users' soulProfiles.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParticipant(users) {
      return isSignedIn() && request.auth.uid in users;
    }

    // Migration-safe connection membership: accepts users[] OR userMap{uid:true}.
    // Covers any legacy/console-seeded connection docs that lack a users[] array.
    function isConnMember(data) {
      return isSignedIn() && (
        (data.users is list && request.auth.uid in data.users)
        || (data.userMap is map && data.userMap.get(request.auth.uid, false) == true)
      );
    }

    // ---------------------------------------------------------------------
    // users/{uid} — owner-only. Includes soulProfile, profile, fcmTokens,
    // basic, and the reflectInsights subcollection.
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);

      // All subcollections (reflectInsights/*, etc.) — owner only.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------------------------------------------------------------------
    // connectionRequests/{id} — only the two involved users.
    // ---------------------------------------------------------------------
    match /connectionRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      // Sender creates a pending request addressed to someone else.
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.status == 'pending';

      // Either party may update status (accept/decline/cancel).
      allow update: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      allow delete: if isSignedIn() && resource.data.fromUid == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // connections/{id} — only participants (migration-safe: users[] OR userMap).
    // ---------------------------------------------------------------------
    match /connections/{connectionId} {
      allow read: if isConnMember(resource.data);
      allow create: if isConnMember(request.resource.data);
      allow update: if isConnMember(resource.data);
      allow delete: if false;

      // messages/* — only participants of the parent connection.
      match /messages/{messageId} {
        function parentData() {
          return get(/databases/$(database)/documents/connections/$(connectionId)).data;
        }
        allow read: if isConnMember(parentData());
        allow create: if isConnMember(parentData())
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // waitlist/{id} — write-only from clients, never readable (T-002).
    // ---------------------------------------------------------------------
    match /waitlist/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // reports/{id} — create-only by the signed-in reporter (T-004).
    // ---------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // giftMessages/{tokenHash} — QR Gift store (feat/expression-gift-v1).
    // Admin-SDK-only: ALL access (create by author, retrieve by recipient,
    // revoke by sender) goes through the Lambda. Clients never read or write
    // directly — the retrieval key is verified server-side and a recipient may
    // have no Seen account. Doc id is SHA-256(token); the raw token is never
    // stored. Closed to every client path.
    // ---------------------------------------------------------------------
    match /giftMessages/{tokenHash} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Gift.Seen Credits + billing-adjacent collections (Monetisation
    // Phase 2). Admin-SDK-only, like giftMessages: balances, the append-only
    // financial ledger, publication idempotency intents, server-minted
    // reply/tag authorizations, reply quotas and throttle windows are ALL
    // server state. No client SDK may ever read or write them — the client
    // gets balances only through the authenticated Lambda API. These blocks
    // are defense-in-depth (default-deny already covers unmatched paths) and
    // self-documentation.
    // ---------------------------------------------------------------------
    match /creditAccounts/{uid} {
      allow read, write: if false;
    }
    match /creditLedger/{entryId} {
      allow read, write: if false;
    }
    match /giftPublishIntents/{intentId} {
      allow read, write: if false;
    }
    match /replyAuth/{grantHash} {
      allow read, write: if false;
    }
    match /replyQuota/{quotaId} {
      allow read, write: if false;
    }
    match /tagPublishAuth/{grantHash} {
      allow read, write: if false;
    }
    match /apiThrottle/{windowId} {
      allow read, write: if false;
    }
    match /giftReplies/{replyId} {
      allow read, write: if false;
    }
    // Phase 3 (events + live capacity billing): purchased seat pools and
    // per-participant seat docs are server state like the ledger — the
    // client reads capacity only through the authenticated Lambda door.
    match /liveCapacity/{capacityId} {
      allow read, write: if false;
    }
    match /liveSeats/{seatId} {
      allow read, write: if false;
    }
    // Payment Phase 2 (real-money foundation): purchase lifecycle records,
    // future provider account-token bindings and future annual Tag service
    // entitlements are ALL server-only financial state — the client learns
    // about purchases exclusively through the authenticated Lambda API.
    match /paymentPurchases/{purchaseId} {
      allow read, write: if false;
    }
    match /paymentAccountTokens/{tokenId} {
      allow read, write: if false;
    }
    match /tagServiceEntitlements/{tagId} {
      allow read, write: if false;
    }
    // FCM Phase 1: push notification audit/dedup events are server-only.
    // (Device tokens themselves live in users/{uid}.fcmTokens under the
    // owner-only rule above — the registration binding IS the auth rule.)
    match /pushEvents/{eventId} {
      allow read, write: if false;
    }

    // Anything not matched above is denied by default.
  }
}
