VITE_APP_URL=https://app.beingseenmatters.com

# T-301 Resonance Engine V2 — production MUST use the server-side matching path.
# 'on' compiles /match/candidate + /profiles/hydrate into the build. Leaving this
# unset/off makes the client fall back to a users-collection scan that owner-only
# Firestore rules reject (permission-denied) → no candidates. Keep this 'on'.
VITE_MATCH_CANDIDATE_API=on
